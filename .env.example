MAI_OLLAMA_MODEL=gemma4:e4b
MAI_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
MAI_OLLAMA_IMAGE_MODEL=gemma4:12b
MAI_OLLAMA_BASE_URL=http://127.0.0.1:11434
MAI_OLLAMA_TIMEOUT=180

MAI_OWNER_ID=owner
# Comma-separated trial account IDs. Example: friend,family
MAI_ALLOWED_USER_IDS=friend,family
MAI_HOST=127.0.0.1
MAI_PORT=8000
MAI_GRAPH_DB=data/graph.sqlite3
MAI_CHAT_DB=data/chat.sqlite3
MAI_UPLOAD_DIR=.mai_uploads
MAI_MAX_UPLOAD_BYTES=26214400
MAI_TERMINAL_ENCODING=utf-8
MAI_SESSION_TTL_SECONDS=2592000

MAI_MARKET_KR_EQUITY_PROVIDER=naver
MAI_MARKET_GLOBAL_EQUITY_PROVIDER=yahoo
MAI_MARKET_INDEX_PROVIDER=yahoo
MAI_MARKET_FX_PROVIDER=yahoo
