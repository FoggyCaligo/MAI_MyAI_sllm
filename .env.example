# Minimal MAI sLLM rebuild
MAI_OLLAMA_HOST=http://127.0.0.1:11434
MAI_OLLAMA_MODEL=qwen3.5:9b
MAI_SERVER_HOST=127.0.0.1
MAI_SERVER_PORT=8010
MAI_DB_PATH=./data/memory.db

# Point this at the EXISTING MK4 Sentence_Breaker database to preserve accumulated learning.
# Example (Windows): C:/Users/<you>/Documents/Git/MACHI/MK4/data/sentence_breaker.db
MAI_SENTENCE_BREAKER_DB_PATH=

# Comma-separated login IDs. First ID is treated as owner in the minimal UI bridge.
MAI_ALLOWED_LOGIN_IDS=

# Fail visibly if Sentence_Breaker cannot load/open the configured DB.
MAI_REQUIRE_SENTENCE_BREAKER=true
