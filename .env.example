# MAI 로컬 계정 정보와 기기별 설정.
# 기본값은 settings.yaml에 있으며 기존 .env 값이 우선한다.
# 실제 비밀번호나 인증 정보를 커밋하지 않는다.

# DB 상대경로는 실행 작업 폴더 기준이며 공식 진입점은 프로젝트 루트를 사용한다.
MEMORY_DB_PATH=./data/memory.sqlite3
SENTENCE_BREAKER_DB_PATH=./data/sentence_breaker.sqlite3
CHAT_DB_PATH=./data/chat.sqlite3
LOG_DB_PATH=./data/log.sqlite3

# 계정: user_id, user_pw(이 로컬 파일에 평문 저장), 고정 db_id.
OWNER_USERS=[{"user_id":"owner","user_pw":"change-me","db_id":"local-user"}]
TRIAL_USERS=[{"user_id":"체험판","user_pw":"0000","db_id":"trial-default"}]

MAI_CWD=
MAI_UPLOAD_ROOT=./mai_uploads
MAI_PUBLIC_BASE_URL=
MAI_HOST=127.0.0.1
MAI_PORT=8000
TAILSCALE_FUNNEL=true

# Google OAuth 비밀키와 토큰 파일은 저장소 밖에 둔다.
VOICE_PROFILE_DIR=./data/voice_profiles
