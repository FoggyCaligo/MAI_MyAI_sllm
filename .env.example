OLLAMA_HOST=http://127.0.0.1:11434
MAIN_MODEL=ornith-1.5:9b
# Memory fact extraction uses the same model selected for the active chat turn.
# There is intentionally no separate MEMORY_MODEL setting.
# Optional Ollama vision model. image_analyze is exposed only when this is set.
# Example: set this to any installed Ollama model that accepts images.
VISION_MODEL=gemma4:12b
OLLAMA_THINK=true
AGENT_MAX_IDENTICAL_CALLS=3
AGENT_MAX_IDENTICAL_FAILURES=2
AGENT_MAX_NO_PROGRESS_ROUNDS=2
TOOL_TIMEOUT_SECONDS=60
TERMINAL_TIMEOUT_SECONDS=120
# Tool outputs at or below this size are sent to the model directly. Larger outputs are
# kept in a per-run result store and exposed to the model/UI as bounded pages.
MAX_INLINE_TOOL_RESULT_CHARS=16000
MEMORY_DB_PATH=./data/memory.sqlite3
SENTENCE_BREAKER_DB_PATH=./data/sentence_breaker.sqlite3
# Persistent account conversation history. This survives browser/device disconnects and server restarts.
CHAT_DB_PATH=./data/chat.sqlite3

# ID-only access control. For multiple owners, configure one JSON object mapping each login ID
# to its independent memory identity. Each owner receives the full owner tool/model permissions.
OWNER_ACCOUNTS={"owner-login":"local-user","parent-login":"parent-memory"}
# Legacy single-owner configuration is still accepted only when OWNER_ACCOUNTS is unset.
# Do not configure these together with OWNER_ACCOUNTS.
# OWNER_ID=change-me-owner
# OWNER_MEMORY_ID=local-user
# Comma-separated optional trial login IDs. Each trial ID also owns its own memory identity.
TRIAL_IDS=trial-user-1,trial-user-2

MAI_CWD=
MAI_HOST=127.0.0.1
MAI_PORT=8000
# Number of recent persisted messages supplied to the model as conversational context.
# The UI can still restore the full persisted conversation.
SESSION_HISTORY_MESSAGES=24
# Public internet exposure through Tailscale Funnel.
TAILSCALE_FUNNEL=false
