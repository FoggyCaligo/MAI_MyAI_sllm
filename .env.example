# MAI local credentials and host-specific overrides.
# Application defaults live in settings.yaml. Existing .env overrides remain effective.
# Never commit real passwords or credentials from this file.

# Existing databases retain their paths relative to the process working directory.
MEMORY_DB_PATH=./data/memory.sqlite3
SENTENCE_BREAKER_DB_PATH=./data/sentence_breaker.sqlite3
CHAT_DB_PATH=./data/chat.sqlite3
LOG_DB_PATH=./data/log.sqlite3

# Account records: user_id, user_pw (plaintext in this local file), stable db_id.
OWNER_USERS=[{"user_id":"owner","user_pw":"change-me","db_id":"local-user"}]
TRIAL_USERS=[{"user_id":"체험판","user_pw":"0000","db_id":"trial-default"}]

MAI_CWD=
MAI_UPLOAD_ROOT=./mai_uploads
MAI_PUBLIC_BASE_URL=
MAI_HOST=127.0.0.1
MAI_PORT=8000
TAILSCALE_FUNNEL=true

# Keep Google OAuth client secrets and token files outside the repository.
VOICE_PROFILE_DIR=./data/voice_profiles
