OLLAMA_HOST=http://127.0.0.1:11434
MAIN_MODEL=ornith-1.5:9b
# Maximum duration allowed for one Ollama chat turn. This applies to both
# normal agent turns and memory fact extraction turns.
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
# Memory fact extraction uses the same model selected for the active chat turn.
# There is intentionally no separate MEMORY_MODEL setting.
# Optional Ollama vision model. image_analyze is exposed only when this is set.
VISION_MODEL=gemma4:e4b
OLLAMA_THINK=true
# When true, MAI asks a separate preflight model turn which native tools must be used.
# false keeps tool choice inside the main agent loop and avoids that extra verifier call.
TOOL_REQUIREMENT_VERIFIER=false

MAI_DEBUG_MODEL_INPUT=false

# Structural repetition guards. No global AGENT_MAX_ROUNDS setting.
# Identical verifier defect repetitions use AGENT_MAX_NO_PROGRESS_ROUNDS too.
# Warning threshold is capped at the configured failure limit.
AGENT_MAX_IDENTICAL_CALLS=3
AGENT_MAX_IDENTICAL_FAILURES=2
AGENT_MAX_NO_PROGRESS_ROUNDS=2

TOOL_TIMEOUT_SECONDS=60
TERMINAL_TIMEOUT_SECONDS=120
MAX_INLINE_TOOL_RESULT_CHARS=8000

MEMORY_DB_PATH=./data/memory.sqlite3
SENTENCE_BREAKER_DB_PATH=./data/sentence_breaker.sqlite3
# Web UI persistent conversation is stored in the dedicated web_chat_messages table.
# Existing unrelated tables inside this SQLite file are preserved.
CHAT_DB_PATH=./data/chat.sqlite3
# Audit/debug history is kept separate from chat and memory databases.
# Local logs may contain sensitive output and remain gitignored.
LOG_DB_PATH=./data/log.sqlite3

MEMORY_RECALL_INCLUDE_UTTERANCES=false

# Account configuration. Each user_info record has exactly three strings:
#   user_id: login ID; may be changed later.
#   user_pw: plaintext login password stored only in the local .env file.
#   db_id: stable internal identity for memory/chat/account data; normally do not change it.
# Keep .env out of Git because user_pw is stored as plaintext by design.
OWNER_USERS=[{"user_id":"owner","user_pw":"change-me","db_id":"local-user"}]
TRIAL_USERS=[{"user_id":"체험판","user_pw":"0000","db_id":"trial-default"}]

MAI_CWD=
MAI_UPLOAD_ROOT=./mai_uploads
# Optional public origin for owner-created file links (for example your Tailscale Funnel URL).
# Without this, file_download_link returns a relative /download/... URL.
MAI_PUBLIC_BASE_URL=
MAI_HOST=127.0.0.1
MAI_PORT=8000
# Number of recent persisted user/assistant messages used both for model conversational context
# and for restored conversation shown in the Web UI. 10 messages is roughly 5 dialogue pairs.
SESSION_HISTORY_MESSAGES=10
TAILSCALE_FUNNEL=true

# Optional owner-only Google Sheets / Drive integration.
# Run scripts/google_oauth_login.py on this machine and point to its token JSON.
# Keep client secret and token files OUTSIDE the git repository.

VOICE_SILENCE_SECONDS=5
VOICE_MIN_SPEECH_SECONDS=0.5
VOICE_MATCH_THRESHOLD=0.65
VOICE_WHISPER_MODEL=small
VOICE_PROFILE_DIR=./data/voice_profiles

# Run the answer-quality reviewer only after factual grounding passes.
# true: factual grounding + quality review; false: factual grounding only.
MAI_ANSWER_QUALITY_REVIEW=true
