# MAI 로컬 계정 정보와 기기별 설정.
# 기본값은 settings.yaml에 있으며 기존 .env 값이 우선한다.
# 실제 비밀번호나 인증 정보를 커밋하지 않는다.

# DB 상대경로는 실행 작업 폴더 기준이며 공식 진입점은 프로젝트 루트를 사용한다.
MEMORY_DB_PATH=./mai/mcp_tools/mcp_memorizer/MAI_MEMORY/memory.sqlite3
SENTENCE_BREAKER_DB_PATH=./mai/mcp_tools/mcp_memorizer/MAI_MEMORY/sentence_breaker.sqlite3
CHAT_DB_PATH=./mai/mcp_tools/mcp_memorizer/MAI_MEMORY/chat.sqlite3
LOG_DB_PATH=./mai/mcp_tools/mcp_memorizer/MAI_MEMORY/log.sqlite3

# 계정: user_id, user_pw(이 로컬 파일에 평문 저장), 고정 db_id.
OWNER_USERS=[{"user_id":"owner","user_pw":"change-me","db_id":"local-user"}]
TRIAL_USERS=[{"user_id":"체험판","user_pw":"0000","db_id":"trial-default"}]

MAI_CWD=
MAI_UPLOAD_ROOT=./mai/mai_uploads
MAI_PUBLIC_BASE_URL=
MAI_HOST=127.0.0.1
MAI_PORT=8000
# 원격 공개는 settings.yaml의 REMOTE_HOSTING_PROVIDER로 선택 (기본 tailscale, none/cloudflare도 가능).
# Cloudflare Dashboard에서 만든 Named Tunnel 토큰. 실제 값은 Git에 올리지 않는다.
# CLOUDFLARE_TUNNEL_TOKEN=

# Google OAuth 비밀키와 토큰 파일은 저장소 밖에 둔다.

# 선택 사항: 외부 LLM API / Hugging Face 데이터 다운로드 인증
# 실제 토큰은 이 예시 파일이 아닌 Git 추적 제외된 루트 .env에만 입력한다.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# MAI_OPENAI_MODELS=gpt-4.1
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
# MAI_ANTHROPIC_MODELS=claude-sonnet-4-5
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
# MAI_OPENROUTER_MODELS=openai/gpt-4.1
# HF_TOKEN=YOUR_HUGGING_FACE_READ_TOKEN
# CLOUD_MAX_OUTPUT_TOKENS=8192
