OLLAMA_HOST=http://127.0.0.1:11434
MAIN_MODEL=ornith-1.5:9b
# Memory fact extraction uses the same model selected for the active chat turn.
# There is intentionally no separate MEMORY_MODEL setting.
# Optional Ollama vision model. image_analyze is exposed only when this is set.
# Example: set this to any installed Ollama model that accepts images.
VISION_MODEL=gemma4:12b
OLLAMA_THINK=true
AGENT_MAX_ROUNDS=30
AGENT_MAX_IDENTICAL_CALLS=3
AGENT_MAX_IDENTICAL_FAILURES=2
AGENT_MAX_NO_PROGRESS_ROUNDS=2
TOOL_TIMEOUT_SECONDS=60
TERMINAL_TIMEOUT_SECONDS=120
MEMORY_DB_PATH=./data/memory.sqlite3
SENTENCE_BREAKER_DB_PATH=./data/sentence_breaker.sqlite3

# ID-only access control. OWNER_ID is the login ID and is required at startup.
OWNER_ID=change-me-owner
# Required memory-graph identity for the owner. Set this to the previous MAI_USER_ID
# (for example local-user or c-test) to continue using that existing User Anchor.
OWNER_MEMORY_ID=local-user
# Comma-separated optional trial login IDs. Each trial ID also owns its own memory identity.
TRIAL_IDS=trial-user-1,trial-user-2

MAI_CWD=
MAI_HOST=127.0.0.1
MAI_PORT=8000
SESSION_HISTORY_MESSAGES=24
# Public internet exposure through Tailscale Funnel.
TAILSCALE_FUNNEL=false
